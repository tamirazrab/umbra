# ============================================
# Application Configuration
# ============================================
NODE_ENV=local
HOST=http://localhost
PORT=3000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug
DATE_FORMAT=YYYY-MM-DD
TZ=UTC

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=nestjs-microservice
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/nestjs-microservice

# PgAdmin Configuration
PGADMIN_EMAIL=admin@umbra.local
PGADMIN_PASSWORD=admin
PGADMIN_URL=http://localhost:5050

# ============================================
# MongoDB Configuration
# ============================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin
MONGO_DATABASE=nestjs-microservice
MONGO_URL=mongodb://admin:admin@localhost:27017/nestjs-microservice?authSource=admin

# Mongo Express Configuration
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin
MONGO_EXPRESS_URL=http://localhost:8081

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=redis
REDIS_URL=redis://:redis@localhost:6379

# ============================================
# Observability - Tracing, Metrics, Logs
# ============================================
# Zipkin - Distributed Tracing UI
ZIPKIN_URL=http://localhost:9411
ZIPKIN_PORT=9411

# Prometheus - Metrics Collection
PROMETHUES_URL=http://localhost:9090
PROMETHEUS_PORT=9090

# Grafana - Visualization & Dashboards
GRAFANA_URL=http://localhost:3001
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager - Prometheus Alerting
ALERTMANAGER_PORT=9093

# Loki - Log Aggregation
LOKI_PORT=3100

# OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
TOKEN_EXPIRATION=1h
REFRESH_TOKEN_EXPIRATION=7d

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@umbra.local

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

