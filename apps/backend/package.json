{
  "name": "@umbra/backend",
  "version": "1.0.0",
  "description": "Umbra Backend - NestJS API",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "bun run migration:run && pm2 start ecosystem.config.js",
    "start:dev": "bun run migration:run && nest start --watch -b swc",
    "start:debug": "bun run migration:run && nest start --debug --watch",
    "dev": "nest start --watch -b swc",
    "lint": "biome check --write ./src ./test",
    "format": "biome format --write ./src ./test",
    "test": "vitest run --reporter=verbose",
    "test:run": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage --reporter=verbose",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "typeorm": "ts-node -r tsconfig-paths/register \"./node_modules/typeorm/cli.js\"",
    "migration-postgres:create": "bun run typeorm migration:create \"./src/infra/database/postgres/migrations/rename\"",
    "migration-postgres:run": "bun run typeorm migration:run -d ./src/infra/database/postgres/config --transaction none",
    "migration-postgres:undo": "bun run typeorm migration:revert -d ./src/infra/database/postgres/config --transaction none",
    "migration-mongo:create": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/config.ts new -n rename",
    "migration-mongo:run": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/config.ts up",
    "migration-mongo:undo": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/config.ts down",
    "migration:run": "concurrently \"bun run migration-postgres:run\" \"bun run migration-mongo:run\""
  },
  "dependencies": {
    "@umbra/types": "workspace:*",
    "@umbra/config": "workspace:*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/instrumentation-http": "^0.208.0",
    "@opentelemetry/instrumentation-mongodb": "^0.61.0",
    "@opentelemetry/instrumentation-pg": "^0.61.0",
    "@opentelemetry/instrumentation-redis-4": "^0.49.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "axios": "^1.13.2",
    "axios-better-stacktrace": "^2.1.7",
    "axios-retry": "^4.5.0",
    "body-parser": "^2.2.0",
    "class-validator": "^0.14.2",
    "colorette": "^2.0.20",
    "compression": "^1.8.1",
    "convert-pino-request-to-curl": "^1.0.8",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "i18next": "^25.6.3",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongo-migrate-ts": "^2.0.0",
    "mongoose": "^9.0.0",
    "mongoose-paginate-v2": "^1.9.1",
    "nestjs-convert-to-curl": "^1.0.7",
    "nestjs-i18n": "^10.5.1",
    "nestjs-otel": "^7.0.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.10",
    "opossum": "^9.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "ping": "^1.0.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-loki": "^2.6.0",
    "pino-pretty": "^13.1.2",
    "pm2": "^6.0.13",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "systeminformation": "^5.27.11",
    "typeorm": "^0.3.27",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.0.0",
    "v8": "^0.1.0",
    "write-excel-file": "^2.3.10",
    "yaml": "^2.8.1",
    "zod": "^4.1.12",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@mikemajesty/microservice-crud": "7.0.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@testcontainers/mongodb": "^11.8.1",
    "@testcontainers/postgresql": "^11.8.1",
    "@testcontainers/redis": "^11.8.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/opossum": "^8.1.9",
    "@types/ping": "^0.4.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "concurrently": "^9.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.14"
  }
}
